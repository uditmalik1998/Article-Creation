  userEmail                     String?   @map("user_email") @db.VarChar(255)
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([flatId])
  @@index([majorCategory])
  @@index([division])
  @@index([approvalStatus])
  @@index([designNumber])
  @@index([vendorName])
  @@index([articleNumber])
