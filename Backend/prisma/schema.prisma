  @@index([createdAt])
  @@index([division, approvalStatus])
  @@index([referenceArticleNumber])
  @@map("article_360_flat")
  @@schema("360article")
}

// ── Raw Articles ─────────────────────────────────────────────────────────────

enum RawArticleStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PERM_FAILED

  @@schema("public")
}

/// Raw SRM article data exactly as received from the SRM API.
/// unique_key = presentation_no + design_number + image_url — prevents duplicate imports.
/// status tracks the processing pipeline state: PENDING → PROCESSING → COMPLETED | FAILED → PERM_FAILED
/// source: ADMIN_MANUAL (admin panel fetch) | CRON_SYNC (12PM/8PM SRM cron)
model RawArticle {
  id                         String            @id @default(uuid())

  // SRM fields (as received)
  presentationNo             String            @map("presentation_no") @db.VarChar(100)
  vendorCode                 String?           @map("vendor_code") @db.VarChar(50)
  vendorName                 String?           @map("vendor_name") @db.VarChar(200)
  division                   String?           @db.VarChar(100)
  subDivision                String?           @map("sub_division") @db.VarChar(100)
  majorCategory              String?           @map("major_category") @db.VarChar(200)
  presentationReceivedDate   DateTime?         @map("presentation_received_date")
  designNumber               String?           @map("design_number") @db.VarChar(255)
  fabric                     String?           @db.VarChar(100)
  noOfColors                 Int?              @map("no_of_colors")
  price                      Decimal?          @db.Decimal(10, 2)
  imageUrl                   String?           @map("image_url")
  presentationsType          String?           @map("Presentations_type") @db.VarChar(200)

  // Dedup key: presentation_no::design_number::image_url (set on insert, never changed)
  uniqueKey                  String            @unique @map("unique_key")

  // Who staged this row: ADMIN_MANUAL (admin panel) or CRON_SYNC (12PM/8PM SRM cron)
  source                     String?           @map("source") @db.VarChar(50)

  // Processing state
  status                     RawArticleStatus  @default(PENDING)

  // Extraction pipeline columns
  retryCount                 Int               @default(0)  @map("retry_count")
  errorMessage               String?           @map("error_message")
  extractedData              Json?             @map("extracted_data")
  extractedAt                DateTime?         @map("extracted_at")
  flatId                     String?           @map("flat_id")        // FK ref to extraction_results_flat
  lockedUntil                DateTime?         @map("locked_until")   // worker lock expiry
  articleNumber              String?           @map("article_number") @db.VarChar(100)

  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@index([presentationNo])
  @@index([status])
  @@index([division])
  @@index([vendorCode])
  @@index([createdAt])
  @@index([source])
  @@index([status, retryCount, lockedUntil])
  @@map("raw_articles")
  @@schema("public")
}

// ── SRM Sync Audit Logs ──────────────────────────────────────────────────────

/// One row per cron/admin/webhook sync execution
model SrmSyncRun {
  id           String         @id @default(uuid())
  triggeredBy  String         @default("CRON") @map("triggered_by") @db.VarChar(64)
  startedAt    DateTime       @default(now()) @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  total        Int            @default(0)
  inserted     Int            @default(0)
  skipped      Int            @default(0)
  patched      Int            @default(0)
  errors       Int            @default(0)
  notes        String?

  items        SrmSyncRunItem[]

  @@map("srm_sync_runs")
  @@schema("public")
}

/// One row per article processed in a sync run — stable link via flat_id even after design number edits
model SrmSyncRunItem {
  id               String               @id @default(uuid())
  runId            String               @map("run_id")
  pptNumber        String?              @map("ppt_number") @db.VarChar(64)
  srmDesignNumber  String?              @map("srm_design_number") @db.VarChar(255)
  flatId           String?              @map("flat_id")
  action           String               @db.VarChar(16)   // INSERTED | SKIPPED | PATCHED | ERROR
  errorMessage     String?              @map("error_message")
  createdAt        DateTime             @default(now()) @map("created_at")

  run              SrmSyncRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  flat             ExtractionResultFlat? @relation(fields: [flatId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([flatId])
  @@index([pptNumber])
  @@map("srm_sync_run_items")
  @@schema("public")
}

// ── Pool B Bulk Jobs ──────────────────────────────────────────────────────────

enum PoolBJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED

  @@schema("public")
}

enum PoolBBatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@schema("public")
}

model PoolBJob {
  id           String         @id @default(uuid()) @db.Uuid
  status       PoolBJobStatus @default(QUEUED)
  env          String
  test         Boolean        @default(false)
  totalRows    Int            @map("total_rows")
  totalBatches Int            @map("total_batches")
  batchSize    Int            @map("batch_size")
  successRows  Int            @default(0) @map("success_rows")
  failedRows   Int            @default(0) @map("failed_rows")
  createdAt    DateTime       @default(now()) @map("created_at")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  batches      PoolBBatch[]

  @@map("pool_b_jobs")
  @@schema("public")
}

model PoolBBatch {
  id           String           @id @default(uuid()) @db.Uuid
  jobId        String           @db.Uuid @map("job_id")
  batchIndex   Int              @map("batch_index")
  status       PoolBBatchStatus @default(QUEUED)
  startRow     Int              @map("start_row")
  endRow       Int              @map("end_row")
  rowCount     Int              @map("row_count")
  successCount Int              @default(0) @map("success_count")
  failedCount  Int              @default(0) @map("failed_count")
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  results      Json?
  errorMessage String?          @map("error_message")
  job          PoolBJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("pool_b_batches")
  @@schema("public")
}

/// NationalGridMaster: Valid attribute code/value pairs imported from the National Grid Excel
model NationalGridMaster {
  id            Int      @id @default(autoincrement())
  attributeName String   @db.VarChar(100) @map("attribute_name")
  code          String   @db.VarChar(100)
  fullForm      String?  @db.VarChar(500) @map("full_form")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([attributeName, code])
  @@index([attributeName])
  @@map("national_grid_master")
  @@schema("public")
}

/// MajorCatMaster: MAJ CAT → name, division, ideal-for, and the model-image FRAME
/// (fw | upper | lower | set) used to decide how the AI model photoshoot is framed.
/// Seeded from "CATEGORY SHEET MJ WISE FINAL"; new entries added from the Model
/// Generation page. Looked up by majCat when generating from article number + colour.
model MajorCatMaster {
  id        Int      @id @default(autoincrement())
  majCat    String   @unique @map("maj_cat") @db.VarChar(100)
  name      String?  @db.VarChar(200)
  div       String?  @db.VarChar(50)
  idealFor  String?  @map("ideal_for") @db.VarChar(50)
  frame     String   @db.VarChar(20)   // 'fw' | 'upper' | 'lower' | 'set'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([frame])
  @@index([div])
  @@map("major_cat_master")
  @@schema("public")
}

/// FabricArticleMaster: Fabric hierarchy reference data (from HIERARCHY MASTER sheet).
/// One row per MC description (article type + major category combination).
model FabricArticleMaster {
  id        Int      @id @default(autoincrement())
  seg       String   @db.VarChar(20)           // Segment (e.g. FAB)
  div       String   @db.VarChar(50)           // Division (e.g. K)
  subDiv    String   @map("sub_div") @db.VarChar(100) // Sub Division (e.g. K_PC)
  majCat    String   @map("maj_cat") @db.VarChar(100) // Major Category (e.g. K_PC_FLC)
  mcCode    String   @map("mc_code") @db.VarChar(20)  // MC Code (e.g. 910101001)
  mcDes     String   @map("mc_des") @db.VarChar(200)  // MC Description (e.g. K_PC_FLC_SLD)
  status    String   @db.VarChar(10)           // ACT / INACT
  hsnCd     String   @map("hsn_cd") @db.VarChar(20)   // HSN Code
  artType   String   @map("art_type") @db.VarChar(20) // Article Type code
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([mcCode, mcDes])
  @@index([majCat])
  @@index([div])
  @@index([subDiv])
  @@index([status])
  @@map("fabric_article_master")
  @@schema("public")
}

/// FabricMajCatGridValues: Valid codes + full-forms for each fabric characteristic (from MASTER sheet).
/// One row per (characteristic, code) pair — e.g. characteristic="M_FAB_DIV", code="K", full_form="KNIT".
model FabricMajCatGridValue {
  id             Int      @id @default(autoincrement())
  characteristic String   @db.VarChar(50)   // Column name from MASTER sheet (e.g. M_FAB_DIV)
  code           String   @db.VarChar(100)  // Short code value (e.g. K)
  fullForm       String   @map("full_form") @db.VarChar(500) // Full description (e.g. KNIT)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([characteristic, code])
  @@index([characteristic])
  @@map("fabric_maj_cat_grid_values")
  @@schema("public")
}

/// ModifyLog: One row per changed label per successful article modification
model ModifyLog {
  id                  Int      @id @default(autoincrement())
  modificationGroupId String   @db.Uuid @map("modification_group_id")
  articleNumber       String   @db.VarChar(30) @map("article_number")
  labelName           String   @db.VarChar(100) @map("label_name")
  oldValue            String?  @map("old_value")
  newValue            String?  @map("new_value")
  modifiedByName      String   @default("") @db.VarChar(200) @map("modified_by_name") // denormalised: user name at time of change
  modifiedByEmail     String   @default("") @db.VarChar(255) @map("modified_by_email") // denormalised: user email at time of change
  modifiedAt          DateTime @default(now()) @map("modified_at")
  sapStatus           String   @default("SUCCESS") @db.VarChar(20) @map("sap_status")

  @@index([articleNumber, modifiedAt(sort: Desc)])
  @@index([modificationGroupId])
  @@index([labelName])
  @@index([modifiedByEmail])
  @@index([modifiedAt(sort: Desc)])
  @@map("modify_logs")
  @@schema("public")
}

/// FabricArticleData: One row per fabric article created from the Construction & Fabric card
model FabricArticleData {
  id                       String    @id @default(uuid())

  // Construction & Fabric card fields (column names = SAP attribute names in lowercase)
  mFabDiv                  String?   @map("m_fab_div")          @db.VarChar(100)
  mYarn                    String?   @map("m_yarn")             @db.VarChar(100)
  mFabMainMvgr1            String?   @map("m_fab_main_mvgr_1")  @db.VarChar(100)
  mFabMainMvgr2            String?   @map("m_fab_main_mvgr_2")  @db.VarChar(100)
  mConstruction            String?   @map("m_construction")     @db.VarChar(100)
  mOunz                    String?   @map("m_ounz")             @db.VarChar(100)
  mWidth                   String?   @map("m_width")            @db.VarChar(100)
  mWeave02                 String?   @map("m_weave_02")         @db.VarChar(100)
  mCount                   String?   @map("m_count")            @db.VarChar(100)
  mWeave01                 String?   @map("m_weave_01")         @db.VarChar(100)
  mComposition             String?   @map("m_composition")      @db.VarChar(200)
  mFinish                  String?   @map("m_finish")           @db.VarChar(100)
  mGsm                     String?   @map("m_gsm")              @db.VarChar(50)
  mLycra                   String?   @map("m_lycra")            @db.VarChar(50)

  // Fabric article output fields
  fabricArticleNumber      String?   @map("fabric_article_number")      @db.VarChar(100)
  fabricArticleDescription String?   @map("fabric_article_description") @db.VarChar(255)

  // Article context
  division                 String?   @map("division")      @db.VarChar(100)
  subDivision              String?   @map("sub_division")  @db.VarChar(100)
  majorCategory            String?   @map("major_category") @db.VarChar(200)
  vendorName               String?   @map("vendor_name")   @db.VarChar(200)
  vendorCode               String?   @map("vendor_code")   @db.VarChar(100)

  // Workflow
  approvalStatus           String    @default("PENDING")    @map("approval_status")    @db.VarChar(20)
  approvedAt               DateTime? @map("approved_at")
  approvedBy               Int?      @map("approved_by")
  sapSyncStatus            String    @default("NOT_SYNCED") @map("sap_sync_status")    @db.VarChar(20)
  sapSyncMessage           String?   @map("sap_sync_message")

  // Audit
  userName                 String?   @map("user_name")  @db.VarChar(200)
  createdAt                DateTime  @default(now())    @map("created_at")
  updatedAt                DateTime  @updatedAt         @map("updated_at")

  @@index([approvalStatus])
  @@index([sapSyncStatus])
  @@index([fabricArticleNumber])
  @@index([majorCategory])
  @@index([division])
  @@index([createdAt(sort: Desc)])
  @@map("fabric_article_data")
  @@schema("public")
}

/// BodyArticleData: One row per body article created from the Body & Construction card
model BodyArticleData {
  id                       String    @id @default(uuid())

  // Body & Construction card attributes (column names = SAP attribute names in lowercase)
  mCollarType              String?   @map("m_collar_type")          @db.VarChar(100)
  mCollarStyle             String?   @map("m_collar_style")         @db.VarChar(100)
  mNeckType                String?   @map("m_neck_type")            @db.VarChar(100)
  mNeckStyle               String?   @map("m_neck_style")           @db.VarChar(100)
  mPlacket                 String?   @map("m_placket")              @db.VarChar(100)
  mBltType                 String?   @map("m_blt_type")             @db.VarChar(100)
  mBltStyle                String?   @map("m_blt_style")            @db.VarChar(100)
  mSleevesMainStyle        String?   @map("m_sleeves_main_style")   @db.VarChar(100)
  mSleeveFold              String?   @map("m_sleeve_fold")          @db.VarChar(100)
  mBtmFold                 String?   @map("m_btm_fold")             @db.VarChar(100)
  mNoOfPocket              String?   @map("m_no_of_pocket")         @db.VarChar(100)
  mPocket                  String?   @map("m_pocket")               @db.VarChar(100)
  mExtraPocket             String?   @map("m_extra_pocket")         @db.VarChar(100)
  mFit                     String?   @map("m_fit")                  @db.VarChar(100)
  mBodyStyle               String?   @map("m_body_style")           @db.VarChar(100)
  mLength                  String?   @map("m_length")               @db.VarChar(100)
  mSet                     String?   @map("m_set")                  @db.VarChar(100)

  // Body article output fields
  bodyArticleNumber        String?   @map("body_article_number")      @db.VarChar(100)
  bodyArticleDescription   String?   @map("body_article_description") @db.VarChar(255)

  // Cost fields
  cmptCost                 Decimal?  @map("cmpt_cost") @db.Decimal(10, 2)
  cmpCost                  Decimal?  @map("cmp_cost")  @db.Decimal(10, 2)
  fabCost                  Decimal?  @map("fab_cost")  @db.Decimal(10, 2)

  // Article context (mirrored from parent extraction_results_flat row)
  flatId                   String?   @map("flat_id")                @db.VarChar(100)
  articleNumber            String?   @map("article_number")         @db.VarChar(100)
  division                 String?   @map("division")               @db.VarChar(100)
  subDivision              String?   @map("sub_division")           @db.VarChar(100)
  majorCategory            String?   @map("major_category")         @db.VarChar(200)
  mcCode                   String?   @map("mc_code")                @db.VarChar(50)
  vendorName               String?   @map("vendor_name")            @db.VarChar(200)
  vendorCode               String?   @map("vendor_code")            @db.VarChar(100)
  season                   String?   @map("season")                 @db.VarChar(50)
  year                     String?   @map("year")                   @db.VarChar(10)
  hsnTaxCode               String?   @map("hsn_tax_code")           @db.VarChar(50)

  // Workflow
  approvalStatus           String    @default("PENDING")    @map("approval_status")  @db.VarChar(20)
  approvedAt               DateTime? @map("approved_at")
  approvedBy               Int?      @map("approved_by")
  sapSyncStatus            String    @default("NOT_SYNCED") @map("sap_sync_status")  @db.VarChar(20)
  sapSyncMessage           String?   @map("sap_sync_message")

  // Audit
  userName                 String?   @map("user_name")   @db.VarChar(200)
  createdAt                DateTime  @default(now())     @map("created_at")
  updatedAt                DateTime  @updatedAt          @map("updated_at")

  @@index([approvalStatus])
  @@index([sapSyncStatus])
  @@index([bodyArticleNumber])
  @@index([majorCategory])
  @@index([division])
  @@index([flatId])
  @@index([articleNumber])
  @@index([createdAt(sort: Desc)])
  @@map("body_article_data")
  @@schema("public")
}
