// ═══════════════════════════════════════════════════════════════════════
// 360article schema — new article creation & attribute data store
// ═══════════════════════════════════════════════════════════════════════

/// Article360: Master record for every article created through the 360 workflow
model Article360 {
  id                          String   @id @default(uuid())
  jobId                       String?  @unique @map("job_id")     // links back to public.extraction_jobs
  flatId                      String?  @unique @map("flat_id")    // links back to public.extraction_results_flat

  // Identity / Header
  division                    String?  @db.VarChar(100)
  subDivision                 String?  @map("sub_division") @db.VarChar(100)
  majorCategory               String?  @map("major_category") @db.VarChar(200)
  designNumber                String?  @map("design_number") @db.VarChar(100)
  vendorName                  String?  @map("vendor_name") @db.VarChar(200)
  vendorCode                  String?  @map("vendor_code") @db.VarChar(100)
  referenceArticleNumber      String?  @map("reference_article_number") @db.VarChar(100)
  referenceArticleDescription String?  @map("reference_article_description")
  articleNumber               String?  @map("article_number") @db.VarChar(100)
  sapArticleId                String?  @map("sap_article_id") @db.VarChar(100)
  imageName                   String?  @map("image_name") @db.VarChar(255)
  imageUrl                    String?  @map("image_url")

  // Status
  approvalStatus              String   @default("PENDING") @map("approval_status") @db.VarChar(20)
  sapSyncStatus               String   @default("NOT_SYNCED") @map("sap_sync_status") @db.VarChar(20)

  // Audit
  userId                      Int?     @map("user_id")
  userName                    String?  @map("user_name") @db.VarChar(200)
  userEmail                   String?  @map("user_email") @db.VarChar(255)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  // Relations to attribute group tables
  fab       ArticleFab?
  body      ArticleBody?
  vaAcc     ArticleVaAcc?
  vaPrcs    ArticleVaPrcs?
  bom       ArticleBom?

  @@index([jobId])
  @@index([flatId])
  @@index([majorCategory])
  @@index([division])
  @@index([approvalStatus])
  @@index([designNumber])
  @@index([vendorName])
  @@index([createdAt])
  @@map("article_360")
  @@schema("360article")
}

/// ArticleFab: FAB group attributes for an Article360
model ArticleFab {
  id            String     @id @default(uuid())
  articleId     String     @unique @map("article_id")
  macroMvgr     String?    @map("macro_mvgr") @db.VarChar(100)
  yarn1         String?    @map("yarn_1") @db.VarChar(100)
  mainMvgr      String?    @map("main_mvgr") @db.VarChar(100)
  fabricMainMvgr String?   @map("fabric_main_mvgr") @db.VarChar(100)
  weave         String?    @db.VarChar(100)
  mFab2         String?    @map("m_fab2") @db.VarChar(100)
  composition   String?    @db.VarChar(200)
  fCount        String?    @map("f_count") @db.VarChar(100)
  fConstruction String?    @map("f_construction") @db.VarChar(100)
  lycra         String?    @db.VarChar(50)
  finish        String?    @db.VarChar(100)
  gsm           String?    @db.VarChar(50)
  fOunce        String?    @map("f_ounce") @db.VarChar(100)
  fWidth        String?    @map("f_width") @db.VarChar(100)
  fabDiv        String?    @map("fab_div") @db.VarChar(100)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  article       Article360 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_fab")
  @@schema("360article")
}

/// ArticleBody: BODY group attributes for an Article360
model ArticleBody {
  id           String     @id @default(uuid())
  articleId    String     @unique @map("article_id")
  collar       String?    @db.VarChar(100)
  collarStyle  String?    @map("collar_style") @db.VarChar(100)
  neck         String?    @db.VarChar(100)
  neckDetails  String?    @map("neck_details") @db.VarChar(200)
  placket      String?    @db.VarChar(100)
  fatherBelt   String?    @map("father_belt") @db.VarChar(100)
  sleeve       String?    @db.VarChar(100)
  sleeveFold   String?    @map("sleeve_fold") @db.VarChar(100)
  mSet         String?    @map("m_set") @db.VarChar(100)
  bottomFold   String?    @map("bottom_fold") @db.VarChar(100)
  noOfPocket   String?    @map("no_of_pocket") @db.VarChar(50)
  pocketType   String?    @map("pocket_type") @db.VarChar(100)
  extraPocket  String?    @map("extra_pocket") @db.VarChar(100)
  fit          String?    @db.VarChar(100)
  bodyStyle    String?    @map("body_style") @db.VarChar(100)
  length       String?    @db.VarChar(100)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  article      Article360 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_body")
  @@schema("360article")
}

/// ArticleVaAcc: VA ACC group attributes for an Article360
model ArticleVaAcc {
  id          String     @id @default(uuid())
  articleId   String     @unique @map("article_id")
  drawcord    String?    @db.VarChar(100)
  dcShape     String?    @map("dc_shape") @db.VarChar(100)
  button      String?    @db.VarChar(100)
  btnColour   String?    @map("btn_colour") @db.VarChar(100)
  zipper      String?    @db.VarChar(100)
  zipColour   String?    @map("zip_colour") @db.VarChar(100)
  patches     String?    @db.VarChar(100)
  patchesType String?    @map("patches_type") @db.VarChar(100)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  article     Article360 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_va_acc")
  @@schema("360article")
}

/// ArticleVaPrcs: VA PRCS group attributes for an Article360
model ArticleVaPrcs {
  id             String     @id @default(uuid())
  articleId      String     @unique @map("article_id")
  printType      String?    @map("print_type") @db.VarChar(100)
  printStyle     String?    @map("print_style") @db.VarChar(100)
  printPlacement String?    @map("print_placement") @db.VarChar(100)
  embroidery     String?    @db.VarChar(100)
  embroideryType String?    @map("embroidery_type") @db.VarChar(100)
  wash           String?    @db.VarChar(100)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  article        Article360 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_va_prcs")
  @@schema("360article")
}

/// ArticleBom: BOM (Bill of Materials) data for an Article360
model ArticleBom {
  id         String     @id @default(uuid())
  articleId  String     @unique @map("article_id")
  rate       Decimal?   @db.Decimal(10, 2)
  mrp        Decimal?   @db.Decimal(10, 2)
  impAtrbt2  String?    @map("imp_atrbt_2") @db.VarChar(200)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  article    Article360 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_bom")
  @@schema("360article")
}

/// SapFieldConfig: Source-of-truth mapping — 360 UI field → SAP RFC field name
model SapFieldConfig {
  id           Int                 @id @default(autoincrement())
  section      String              @db.VarChar(50)
  uiLabel      String              @map("ui_label") @db.VarChar(100)
  dbField      String              @unique @map("db_field") @db.VarChar(100)
  sapField     String              @map("sap_field") @db.VarChar(100)
  isActive     Boolean             @default(true) @map("is_active")
  displayOrder Int                 @default(0) @map("display_order")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  values       SapAttributeValue[]

  @@index([section])
  @@index([sapField])
  @@map("sap_field_config")
  @@schema("360article")
}

/// SapAttributeValue: Allowed dropdown values per field, optionally scoped to a major category
model SapAttributeValue {
  id            Int            @id @default(autoincrement())
  fieldConfigId Int            @map("field_config_id")
  value         String         @db.VarChar(200)
  majorCategory String?        @map("major_category") @db.VarChar(200)
  displayOrder  Int            @default(0) @map("display_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  fieldConfig   SapFieldConfig @relation(fields: [fieldConfigId], references: [id], onDelete: Cascade)

  @@unique([fieldConfigId, value, majorCategory])
  @@index([fieldConfigId, majorCategory, isActive])
  @@map("sap_attribute_value")
  @@schema("360article")
}

/// Article360Flat: Denormalized flat table — single row per article, all fields in one place
model Article360Flat {
