{
  "name": "ai-fashion-extractor-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Fashion Attribute Extractor",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node scripts/free-port.js",
    "dev": "nodemon src/index.ts",
    "build": "prisma generate && tsc --skipLibCheck && npm run postbuild",
    "postbuild": "node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive: true}); require('fs').cpSync('src/data', 'dist/data', {recursive: true})\"",
    "postinstall": "prisma generate",
    "start": "node --max-old-space-size=2048 dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed-fast.ts",
    "db:seed:slow": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:test": "ts-node scripts/test-db-queries.ts",
    "db:backfill:image-urls": "ts-node scripts/backfill-image-urls.ts",
    "db:backfill:image-uploads": "ts-node scripts/backfill-missing-image-uploads.ts",
    "db:backfill:mrp": "ts-node scripts/backfill-mrp-from-rate.ts",
    "db:backfill:gsm-weight": "ts-node scripts/backfill-gsm-weight.ts",
    "db:refresh:mfab2": "ts-node scripts/refresh-mfab2-from-json.ts",
    "db:normalize:fabric-values": "ts-node scripts/normalize-fabric-attribute-values.ts",
    "db:sync:major-categories": "ts-node scripts/sync-major-categories-from-json.ts",
    "db:subdivisions:upsert-final": "ts-node scripts/upsert-final-subdivisions.ts",
    "sap:unique-values": "ts-node scripts/extract-sap-unique-values.ts",
    "sap:sync": "ts-node scripts/sync-sap-attribute-values.ts",
    "sap:sync:daily": "npm run sap:sync",
    "excel:sync:mandatory": "ts-node scripts/sync-mandatory-grid.ts",
    "excel:sync": "ts-node scripts/sync-excel-attribute-values.ts",
    "excel:sync:watch": "ts-node scripts/sync-excel-attribute-values.ts --watch",
    "excel:map-to-extraction": "ts-node scripts/sync-excel-to-extraction-values.ts",
    "backfill:extraction:matched": "ts-node scripts/backfill-extraction-matched-values.ts",
    "fix:bottom-fold-format": "ts-node scripts/fix-bottom-fold-format.ts",
    "normalize:attribute:value-formats": "ts-node scripts/normalize-attribute-value-formats.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed-fast.ts"
  },
  "keywords": [
    "ai",
    "fashion",
    "api",
    "openai"
  ],
  "author": "Shubham Kushvanshi",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/lib-storage": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.17.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "prisma": "6.17.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.8.1",
    "@types/node": "^24.10.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  }
}
